# Frontend environment — spec 01
# Copy to `frontend/.env.local`. Only NEXT_PUBLIC_* values reach the browser.
#
# There is NO Supabase key here, of any kind. The browser never talks to
# Supabase directly (01-overview §1.1); all data comes from the Express API.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Canonical site origin for Fabrillke (fabrillke.com), no trailing slash.
# Used for canonical URLs, Open Graph/Twitter URLs, sitemap.xml and robots.txt
# (spec 07 SEO; `seo` skill 3-4). Leave unset in production to fall back to
# https://fabrillke.com; set it on preview/staging so those deployments
# canonicalize to themselves instead of to production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
