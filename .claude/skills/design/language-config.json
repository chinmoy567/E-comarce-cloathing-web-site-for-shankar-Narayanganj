{
  "projectName": "Bangladesh Fashion E-Commerce",
  "supportedLanguages": [
    {
      "code": "en",
      "name": "English",
      "nativeName": "English",
      "direction": "ltr",
      "default": false
    }
  ],
  "languageConfig": {
    "storage": "localStorage",
    "storageKey": "language",
    "fallbackLanguage": "en",
    "detectionMethod": "none",
    "defaultLanguage": "en",
    "note": "UI ships English-only per CLAUDE.md section 8 and SKILL.md \"English-Only UI\". translations.bn is retained for reference only and must not be wired to a language switcher unless English-only is formally revisited."
  },
  "fonts": {
    "bn": {
      "primary": "'SiyamRupali', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "secondary": "'SiyamRupali', sans-serif",
      "googleFonts": "https://fonts.googleapis.com/css2?family=SiyamRupali&display=swap"
    },
    "en": {
      "primary": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "secondary": "'Inter', sans-serif",
      "googleFonts": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    }
  },
  "currencyFormat": {
    "bn": {
      "symbol": "৳",
      "position": "left",
      "separator": ",",
      "decimal": ".",
      "decimalPlaces": 2,
      "example": "৳ 1,500.00"
    },
    "en": {
      "symbol": "৳",
      "position": "left",
      "separator": ",",
      "decimal": ".",
      "decimalPlaces": 2,
      "example": "৳ 1,500.00"
    }
  },
  "dateFormat": {
    "bn": {
      "format": "DD MMM YYYY",
      "example": "১৭ সেপ্টেম্বর ২০২৬"
    },
    "en": {
      "format": "DD MMM YYYY",
      "example": "17 Sep 2026"
    }
  },
  "phoneFormat": {
    "bn": {
      "country": "Bangladesh",
      "countryCode": "+880",
      "example": "+880 1700 000000"
    },
    "en": {
      "country": "Bangladesh",
      "countryCode": "+880",
      "example": "+880 1700 000000"
    }
  },
