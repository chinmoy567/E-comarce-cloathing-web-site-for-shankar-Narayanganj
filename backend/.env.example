# Backend environment — spec 01
# Copy to `backend/.env` and fill in real values. NEVER commit `.env`.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Direct PostgreSQL connection (Project Settings -> Database -> Connection string)
# Used by the migration runner and by withTransaction (spec 02), which is the
# single transaction mechanism for every multi-statement atomic operation.
#
# PG_POOL_MAX is explicit, not the driver default: this pool and the Supabase
# client draw on the SAME Supabase connection cap, and an unbounded pool under
# checkout load exhausts it — failing order creation.
DATABASE_URL=postgresql://postgres:[DXD&7d+2z6D%6nQ]@db.bhkvtjvvsecqvqdllmir.supabase.co:5432/postgres
PG_POOL_MAX=10

# Comma-separated allowlist. A wildcard (*) is rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public storefront origin for Fabrillke (fabrillke.com), no trailing slash.
# Used to build absolute links in outbound email and in CMS cta_url validation
# ("the store's own domain", 13-homepage-cms 13.13). Production: https://fabrillke.com
PUBLIC_SITE_URL=http://localhost:3000
