# Backend environment — spec 01
# Copy to `backend/.env` and fill in real values. NEVER commit `.env`.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Direct PostgreSQL connection (Project Settings -> Database -> Connection string)
# Used by the migration runner, and by withTransaction from spec 02 onward.
DATABASE_URL=postgresql://postgres:[DXD&7d+2z6D%6nQ]@db.bhkvtjvvsecqvqdllmir.supabase.co:5432/postgres
PG_POOL_MAX=10

# Comma-separated allowlist. A wildcard (*) is rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:3000
