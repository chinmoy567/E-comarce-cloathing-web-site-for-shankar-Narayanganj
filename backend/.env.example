# Backend environment — spec 01
# Copy to `backend/.env` and fill in real values. NEVER commit `.env`.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Direct PostgreSQL connection (Project Settings -> Database -> Connection string)
# Used by the migration runner and by withTransaction (spec 02), which is the
# single transaction mechanism for every multi-statement atomic operation.
#
# PG_POOL_MAX is explicit, not the driver default: this pool and the Supabase
# client draw on the SAME Supabase connection cap, and an unbounded pool under
# checkout load exhausts it — failing order creation.
DATABASE_URL=postgresql://postgres:[DXD&7d+2z6D%6nQ]@db.bhkvtjvvsecqvqdllmir.supabase.co:5432/postgres
PG_POOL_MAX=10

# Comma-separated allowlist. A wildcard (*) is rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public storefront origin for Fabrillke (fabrillke.com), no trailing slash.
# Used to build absolute links in outbound email and in CMS cta_url validation
# ("the store's own domain", 13-homepage-cms 13.13). Production: https://fabrillke.com
PUBLIC_SITE_URL=http://localhost:3000

# Back-office session signing secrets (spec 03). Generate with, e.g.,
# `openssl rand -hex 32`. Never reuse one secret for both — they sign different
# token kinds and must not be interchangeable.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long
ADMIN_ACCESS_TOKEN_TTL_MIN=15
ADMIN_REFRESH_TOKEN_TTL_DAYS=7

# Admin seed (spec 03 §5.12.1) — set only when running `npm run seed:admin`.
# Never commit real values; the seed script never prints SEED_ADMIN_PASSWORD.
SEED_ADMIN_USER_ID=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-password-12-chars-min

# Rate limiting and hardening (spec 04 §11.2/§11.3/§11.4). `memory` is fine for
# a single instance; a multi-instance deployment MUST set `redis` + REDIS_URL,
# or limits are not enforced consistently across instances.
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://localhost:6379

# Number of trusted reverse-proxy/CDN hops in front of this process. Determines
# how many entries of X-Forwarded-For are trusted for the rate limiter's IP key.
TRUST_PROXY_HOPS=1

# Aborts a request that runs longer than this with 503 (§11.4).
REQUEST_TIMEOUT_MS=30000

# Every threshold below is env-configurable per §11.3, all in seconds unless named _MAX.
RL_CUSTOMER_LOGIN_MAX=5
RL_CUSTOMER_LOGIN_WINDOW_SEC=900
RL_ADMIN_LOGIN_MAX=5
RL_ADMIN_LOGIN_WINDOW_SEC=900
RL_ADMIN_LOGIN_LOCKOUT_MAX_SEC=3600
RL_OTP_REQUEST_MAX=3
RL_OTP_REQUEST_WINDOW_SEC=900
RL_OTP_VERIFY_MAX=5
RL_REGISTRATION_MAX=5
RL_REGISTRATION_WINDOW_SEC=3600
RL_GUEST_LOOKUP_MAX=5
RL_GUEST_LOOKUP_WINDOW_SEC=900
RL_GUEST_LOOKUP_LOCKOUT_SEC=1800
RL_TRACK_ORDER_MAX=10
RL_TRACK_ORDER_WINDOW_SEC=900
RL_COUPON_VALIDATE_MAX=10
RL_COUPON_VALIDATE_WINDOW_SEC=600
RL_RISK_CHECK_MAX=3
RL_RISK_CHECK_WINDOW_SEC=900
RL_AUTH_CEILING_MAX=100
RL_AUTH_CEILING_WINDOW_SEC=60
RL_PUBLIC_CEILING_MAX=60
RL_PUBLIC_CEILING_WINDOW_SEC=60
